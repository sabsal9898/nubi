rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rehearsal sessions collection rules for band members
    match /rehearsal_sessions/{sessionId} {
      allow read, write: if true;
    }
    // Shared settings such as quick-select band members
    match /settings/{settingId} {
      allow read, write: if true;
    }
    // Connection test document
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
